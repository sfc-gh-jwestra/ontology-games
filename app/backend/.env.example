# Optional: copy to .env to override the Live-mode defaults. No login settings are needed.
# Recorded mode, Setup and Analysis never connect to Snowflake.
# Live mode opens this connections.toml profile on the first Live run (browser login if the profile uses
# externalbrowser or OAUTH_AUTHORIZATION_CODE), then reuses it.
SNOWFLAKE_CONNECTION_NAME=ONTOLOGY_DEMO_CONN
APP_ROLE=ONTOLOGY_APP_ROLE
APP_WAREHOUSE=COMPUTE_WH
