# Copy to .env and fill in. .env is gitignored.
SNOWFLAKE_ACCOUNT=SFSENORTHAMERICA-JWESTRA_AWS1
SNOWFLAKE_ACCOUNT_URL=https://sfsenorthamerica-jwestra-aws1.snowflakecomputing.com
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# OAuth client: leave blank and the backend reads it from the integration on first sign-in
# (SYSTEM$SHOW_OAUTH_CLIENT_SECRETS) using a connections.toml profile whose role owns the integration.
# The secret stays in memory only. Set both values to skip the lookup.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_INTEGRATION=ONTOLOGY_COMPARE_LOCAL_OAUTH
OAUTH_SECRETS_CONNECTION=JWESTRA_AWS1
OAUTH_SECRETS_ROLE=ACCOUNTADMIN
# Must match OAUTH_REDIRECT_URI on the integration. Vite (:5173) proxies /oauth to FastAPI.
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
# Where to send the browser after sign-in.
APP_URL=http://localhost:5173

# Roles offered at sign-in (comma-separated). The default must be in the list.
APP_ROLES=ONTOLOGY_APP_ROLE
APP_DEFAULT_ROLE=ONTOLOGY_APP_ROLE
